# ============================================================
# LISION — Environment Variables
# ============================================================

# Supabase
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Tenant ID padrão para login por PIN (operadores)
NEXT_PUBLIC_DEFAULT_TENANT_ID="your-tenant-uuid-here"
# Optional 32-byte base64 or 64-char hex key for AES-256-GCM faction PIN storage.
# If omitted temporarily, the server derives a domain-separated key from SUPABASE_SERVICE_ROLE_KEY.
FACTION_PIN_ENCRYPTION_KEY=
